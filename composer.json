{
  "name": "joshuadavidnelson/disable-blog",
  "description": "A comprehensive WordPress plugin disabling blog-related functionality.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0+",
  "homepage": "https://disable.blog",
  "authors": [
    {
      "name": "Joshua Nelson",
      "email": "josh@joshuadnelson.com",
      "homepage": "https://joshuadnelson.com"
    }
  ],
  "scripts": {
    "lint": [
      "find *.php includes/ -type f -name '*.php' -print0 | xargs -0 -L1 -P4 -- php -l"
    ],
    "phpcs": [
      "./vendor/bin/phpcs"
    ],
    "phpcbf": [
      "./vendor/bin/phpcbf"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --memory-limit=2048M"
    ],
    "phpmd": [
      "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmd disable-blog.php,includes/ text phpmd.xml"
    ],
    "phpunit": [
      "@php ./vendor/bin/phpunit"
    ],
    "test": [
      "@phpunit"
    ],
    "phpunit:coverage": [
      "@php -dpcov.enabled=0 -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-text"
    ],
    "test:coverage": [
      "@phpunit:coverage"
    ],
    "phpunit:coverage-clover": [
      "@php -dpcov.enabled=0 -dxdebug.mode=coverage ./vendor/bin/phpunit --coverage-clover coverage/php-clover.xml"
    ],
    "phpmetrics": [
      "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmetrics --composer=false --report-html=reports/metrics --report-json=reports/metrics.json disable-blog.php includes/"
    ],
    "phpmetrics-summary": [
      "@php -r \"is_dir('reports') || mkdir('reports', 0777, true);\"",
      "php -d error_reporting='E_ALL & ~E_DEPRECATED' ./vendor/bin/phpmetrics --composer=false --report-summary-json=reports/metrics-summary.json disable-blog.php includes/"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/joshuadavidnelson/disable-blog/issues/",
    "forum": "https://wordpress.org/support/plugin/disable-blog/",
    "source": "https://github.com/joshuadavidnelson/disable-blog/"
  },
  "require": {
    "php": ">=7.4",
    "composer/installers": "^2.0"
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "7.4"
    }
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.11",
    "phpstan/phpstan": "^2.2",
    "phpstan/extension-installer": "^1.4",
    "dealerdirect/phpcodesniffer-composer-installer": "^0.7",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "sirbrillig/phpcs-variable-analysis": "^2.12",
    "automattic/vipwpcs": "^3.0",
    "phpunit/phpunit": "^9.6",
    "10up/wp_mock": "^1.1",
    "yoast/phpunit-polyfills": "^4.0",
    "mockery/mockery": "^1.6",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpmd/phpmd": "^2.15",
    "phpmetrics/phpmetrics": "^2.8"
  }
}
