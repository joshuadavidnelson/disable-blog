{
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true
	},
	"core": "https://wordpress.org/wordpress-7.1.5.zip",
	"phpVersion": "8.3",
	"testsEnvironment": true,
	"themes": [
		"https://downloads.wordpress.org/theme/twentytwentytwo.zip"
	],
	"port": 8888,
	"testsPort": 8889,
	"mappings": {
		"wp-content/plugins/disable-blog": ".",
		"wp-content/mu-plugins": "./tests/e2e/fixtures"
	},
	"lifecycleScripts": {
		"afterStart": "npx --no-install wp-env run cli wp plugin activate disable-blog && npx --no-install wp-env run tests-cli wp plugin activate disable-blog"
	},
	"env": {
		"tests": {
			"config": {
				"DWPB_TEST_FIXTURES": true
			}
		}
	}
}
