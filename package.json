{
  "name": "disable-blog",
  "version": "0.5.6",
  "description": "A comprehensive WordPress plugin disabling blog-related functionality.",
  "author": "Joshua David Nelson",
  "license": "GPL-2.0-or-later",
  "homepage": "https://disable.blog/",
  "repository": {
    "type": "git",
    "url": "git@github.com:joshuadavidnelson/disable-blog.git"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "scripts": {
    "env": "wp-env",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:shell": "wp-env run tests-cli /bin/bash",
    "env:debuglog": "wp-env run tests-cli tail -f /var/www/html/wp-content/debug.log",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:ui": "playwright test --config playwright.config.ts --ui",
    "test:e2e:core-version": "node ./tests/bin/set-core-version.js",
    "test:compat-unit": "node --test \"tests/compat/**/*.test.js\"",
    "test:ci-scripts": "node --test \".github/scripts/**/*.test.ts\"",
    "compat:dump": "node tests/compat/surface.js dump",
    "compat:check": "node tests/compat/surface.js check",
    "compat:update": "node tests/compat/surface.js update",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^20.17.10",
    "@wordpress/e2e-test-utils-playwright": "^3.3.0",
    "@wordpress/env": "^12.0.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "qs": "~6.16.1",
    "glob": "^14.0.3",
    "isomorphic-git": "~1.38.6"
  }
}
